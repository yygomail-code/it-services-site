# Копия: cp .env.example .env  (заполните реальные значения)
APP_ENV=dev

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=it_services
DB_USER=root
DB_PASS=

# Куда присылать заявки с сайта
MAIL_TO=hello@example.ru

# SMTP-сервисы (Яндекс, Mail.ru и т.д.) настраиваются в админке:
# раздел «Почта» → «Добавить сервис». В dev без сервиса письма ждут в очереди.
