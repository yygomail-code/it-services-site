# Правила для хостинга на Apache (файл попадает в сборку из public/).
# Задача: отдать prerender-HTML, а для клиентских маршрутов (/admin, /login,
# /profile, /pages/*) — каркас приложения index.csr.html.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Существующие файлы и каталоги — как есть (страницы, api, uploads, статика)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Несуществующие адреса API и медиа — честный 404, а не каркас SPA
  RewriteRule ^(api|uploads)/ - [L,R=404]

  # Остальное — клиентское приложение (админка, кабинет, страницы из БД)
  RewriteRule ^ index.csr.html [L]
</IfModule>

# Кэширование статики: файлы с хэшем в имени можно кэшировать надолго
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Не отдавать конфиги, дампы и служебные файлы
<IfModule mod_authz_core.c>
  <FilesMatch "\.(env|log|sql|md)$">
    Require all denied
  </FilesMatch>
</IfModule>
